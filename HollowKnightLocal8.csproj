<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="LocalBuildProperties.props" Condition="Exists('LocalBuildProperties.props')" />
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>HollowKnightLocal8</AssemblyName>
    <RootNamespace>KO.HollowKnight8</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PathMap>$(MSBuildProjectDirectory)=source</PathMap>
    <HKManagedDir Condition="'$(HKManagedDir)' == ''">$(References)</HKManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs;Properties/AssemblyInfo.cs" />
    <EmbeddedResource Include="assets/*">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <Reference Include="$(HKManagedDir)/*.dll"
               Exclude="$(HKManagedDir)/UnitySceneRepacker.dll;$(HKManagedDir)/HollowKnightLocal8.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(HKManagedDir)/Assembly-CSharp.dll')" Text="Set HKManagedDir to your Modding API-patched hollow_knight_Data/Managed directory." />
    <Error Condition="!Exists('$(HKManagedDir)/MMHOOK_Assembly-CSharp.dll')" Text="The matching Modding API hook assemblies are required." />
  </Target>
</Project>
